# Copy to repository root .env; commands read ../../.env from the API workspace.
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
# Relative database paths resolve from repository root, not shell working directory.
DATABASE_URL=./data/neighborhood.db
DEMO_MODE=true
# OpenAI-compatible chat completions API base (include /v1 if the provider requires it).
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
