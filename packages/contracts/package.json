{
  "name": "@neighborhood/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "generate:openapi": "tsx scripts/generate-openapi.ts"
