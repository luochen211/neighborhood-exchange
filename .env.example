# Copy to .env at the repository root. Development opens http://127.0.0.1:5173.
HOST=127.0.0.1
PORT=3000
# For npm start, change this to http://127.0.0.1:3000.
APP_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=./data/neighborhood.db
# Optional remote demo HTTP Basic access gate; configure both together.
DEMO_ACCESS_USER=
DEMO_ACCESS_PASSWORD=
DEMO_MODE=true
# Server only; leave empty until the AI task configures a provider.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
